# Development Dockerfile for DQ Tahfiz API

FROM php:8.4-fpm-alpine

# Install system dependencies
RUN apk add --no-cache \
    nginx \
    supervisor \
    icu-dev \
    oniguruma-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    curl \
    autoconf \
    g++ \
    make \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
    pdo_mysql \
    mysqli \
    intl \
    mbstring \
    opcache \
    pcntl \
    zip \
    gd \
    && pecl install pcov \
    && docker-php-ext-enable pcov \
    && apk del autoconf g++ make \
    && rm -rf /var/cache/apk/*

# PHP dev config
RUN mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"
COPY docker/php.dev.ini /usr/local/etc/php/conf.d/zz-dev-overrides.ini

# Nginx config
COPY docker/nginx.dev.conf /etc/nginx/http.d/default.conf

# Supervisor config
COPY docker/supervisord.conf /etc/supervisord.conf

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copy composer files first for caching
COPY composer.json composer.lock ./
RUN composer install --no-scripts --no-autoloader --prefer-dist

# Copy application code
COPY . .

# Generate autoload (with dev dependencies)
RUN composer dump-autoload --optimize

# Stage vendor into a cache dir outside the bind mount path
RUN cp -a /var/www/html/vendor /tmp/vendor-cache

# Laravel setup
RUN php artisan config:clear \
    && php artisan route:clear \
    && php artisan view:clear

# Permissions
RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Create nginx pid/log dirs
RUN mkdir -p /run/nginx /var/log/nginx

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Entrypoint populates vendor volume from build cache on first run
COPY docker/entrypoint.dev.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
